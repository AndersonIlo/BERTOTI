// CASO NÃO RODE APOS BAIXAR O MODELO, CLICAR NO LADO DIREITO DO GIT NO SIMBOLO DO MAVE E FORÇAR ELE A CARREGAR NOVAMENTE

package org.example;

import java.util.Scanner;
import io.github.ollama4j.Ollama;
import io.github.ollama4j.models.chat.OllamaChatMessageRole;
import io.github.ollama4j.models.chat.OllamaChatRequest;
import io.github.ollama4j.models.chat.OllamaChatResult;

public class Main {

    public static void main(String[] args) throws Exception {

        // We're just using our quick-setup utility here to instantiate Ollama. Use the following
        // to set it up with your Ollama configuration.
        Ollama ollama = new Ollama("http://127.0.0.1:11434/");
        String model = "hf.co/tardellirs/aac-board-generator-770m-ptbr-GGUF:Q4_K_M";
        ollama.pullModel(model);
        ollama.setRequestTimeoutSeconds(300);
        OllamaChatRequest builder = OllamaChatRequest.builder().withModel(model);

        String tema;
        Scanner s = new Scanner(System.in);
        System.out.println("Digite o tema:");
        tema = s.nextLine();

        // create first user question
        OllamaChatRequest requestModel =
                builder.withMessage(OllamaChatMessageRole.USER, "Você monta pranchas de CAA (Comunicação Aumentativa e Alternativa) com pictogramas, em português brasileiro.\n" +
                                "Tema: " + tema + "\n\n" +
                                "Liste 12 itens concretos e diretamente relacionados ao tema, sendo exatamente 2 de cada tipo, nesta ordem: " +
                                "Verbos, Substantivos, Adjetivos, Estratégias, Lugares, Pronomes.\n" +
                                "Formato de cada linha: tipo | palavra | sinônimo\n\n" +
                                "Exemplos de cada tipo (não use estas palavras, é só referência):\n" +
                                "Verbos: ações, como querer, ir, comer\n" +
                                "Substantivos: objetos, como água, brinquedo, bola\n" +
                                "Adjetivos: características, como bom, grande, feio\n" +
                                "Estratégias: fórmulas sociais, como olá, obrigado, por favor\n" +
                                "Lugares: posições e recintos, como escola, hospital, casa\n" +
                                "Pronomes: pessoas, como eu, você, ele\n\n" +
                                "Regras:\n" +
                                "- Não repita palavras.\n" +
                                "- Responda apenas com as 12 linhas da lista, sem título, numeração, comentário ou texto extra."
                        ).build();

        // start conversation with model
        OllamaChatResult chatResult = ollama.chat(requestModel, null);

        System.out.println(
                "Resposta:" + chatResult.getResponseModel().getMessage().getResponse());
    }
}

